{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"duotone": [],
			"gradients": [],
			"palette": [
				{
					"color": "#41068B",
					"name": "Primary Purple",
					"slug": "primary"
				},
				{
					"color": "#674098",
					"name": "Primary Dark",
					"slug": "primary-dark"
				},
				{
					"color": "#8740A6",
					"name": "Primary Light",
					"slug": "primary-light"
				},
				{
					"color": "#D895C",
					"name": "Accent Orange",
					"slug": "accent"
				},
				{
					"color": "#E2A49",
					"name": "Accent Light",
					"slug": "accent-light"
				},
				{
					"color": "#F1D544",
					"name": "Accent Bright",
					"slug": "accent-bright"
				},
				{
					"color": "#D5CEE1",
					"name": "Neutral Light",
					"slug": "neutral-light"
				},
				{
					"color": "#DFCFE1",
					"name": "Neutral BG",
					"slug": "neutral-bg"
				},
				{
					"color": "#D0D8E7",
					"name": "Neutral Gray",
					"slug": "neutral-gray"
				},
				{
					"color": "#FFFFFF",
					"name": "White",
					"slug": "white"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem"
			]
		},
		"typography": {
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "Inter, system-ui, -apple-system, sans-serif",
					"name": "Inter",
					"slug": "inter"
				},
				{
					"fontFamily": "\"Noto Sans\", Inter, system-ui, sans-serif",
					"name": "Noto Sans",
					"slug": "noto-sans"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"name": "Base",
					"size": "1.125rem",
					"slug": "base"
				},
				{
					"name": "Large",
					"size": "1.5rem",
					"slug": "large"
				},
				{
					"name": "X-Large",
					"size": "2.25rem",
					"slug": "xlarge"
				}
			],
			"fontWeight": {
				"200": "Thin",
				"400": "Normal"
			}
		}
	},
	"styles": {
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--noto-sans)",
					"fontWeight": "400"
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--neutral-light)",
			"text": "var(--wp--preset--color--primary)"
		},
		"spacing": {
			"blockGap": "2rem",
			"padding": {
				"bottom": "2rem",
				"left": "2rem",
				"right": "2rem",
				"top": "2rem"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Site Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Site Footer"
		},
		{
			"area": "uncategorized",
			"name": "help-banner",
			"title": "Help Banner"
		}
	]
}